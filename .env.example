# === App / General ===
APP_ENV=development
APP_VERSION=1.0.0
APP_PORT=5001

# === Server ===
SERVER_PORT=:5001
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
# Origins for frontend (CORS)
SERVER_ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:8081

# === Database (PostgreSQL) ===
# Note: Host id 'db' because that is the service name in docker-compose
DB_URL=postgres://username:password@localhost:5432/expense_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# === Cache (Redis) ===
# Note: Host is 'redis' because that is the service name in docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

# === Authentication (PASETO) ===
# Needs to be a 32-character random string for v4.local
AUTH_PASETO_KEY=your-32-character-random-string
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h

# === External Integrations ===
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox